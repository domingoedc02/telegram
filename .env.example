# Copy to .env and fill in. See spec/setup (ORBIT team memory) for full details on every variable.
# Local defaults below point at infra/compose/docker-compose.yml's services.

NODE_ENV=development
APP_ENV=development
APP_URL=http://localhost:5173
PORT=3000

DATABASE_URL=postgres://tg:tg@localhost:5432/tg
BACKUP_DB_PASSWORD=changeme-not-used-locally

REDIS_URL=redis://localhost:6379

SESSION_SECRET=changeme-64-char-hex-use-openssl-rand-hex-32
SESSION_COOKIE_NAME=tg_sess
SESSION_TTL_DAYS=30
SESSION_ABSOLUTE_CAP_DAYS=90
CSRF_HEADER_NAME=X-Requested-With

ARGON2_MEMORY_KIB=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

RESET_TTL_MINUTES=60
INVITE_TTL_DAYS=7

BODY_LIMIT_BYTES=1048576
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_IP_MAX=20
RATE_LIMIT_FORGOT_PASSWORD_EMAIL_MAX=3
RATE_LIMIT_FORGOT_PASSWORD_IP_MAX=10
RATE_LIMIT_INVITE_MAX=20
RATE_LIMIT_MESSAGE_BURST=10
RATE_LIMIT_MESSAGE_SUSTAINED_PER_SEC=3

WS_MAX_CONNECTIONS_PER_USER=5
WS_MAX_PAYLOAD_BYTES=16384
WS_PATH=/ws

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=dev@local.test
SMTP_PASS=changeme
SMTP_TIMEOUT_MS=10000
MAIL_FROM="Enlinka Chat <notifications@local.test>"

VAPID_PUBLIC_KEY=changeme-generate-with-web-push-generate-vapid-keys
VAPID_PRIVATE_KEY=changeme-generate-with-web-push-generate-vapid-keys
VAPID_SUBJECT=mailto:admin@local.test

VITE_APP_URL=http://localhost:5173
VITE_VAPID_PUBLIC_KEY=changeme-same-as-VAPID_PUBLIC_KEY

CUTOVER_DATE=

MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=tg-backups
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
BACKUP_RETENTION_DAYS=14
BACKUP_CRON=0 2 * * *

LOG_LEVEL=info

ADMIN_BOOTSTRAP_EMAIL=admin@local.test
ADMIN_BOOTSTRAP_PASSWORD=ChangeMe123!
